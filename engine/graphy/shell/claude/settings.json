{
  "hooks": {
    "PreCompact": [
      {"hooks": [{"type": "command", "command": "\"$CLAUDE_PROJECT_DIR/.graphy/hooks/session_end.sh\"", "timeout": 30}]}
    ],
    "SessionEnd": [
      {"hooks": [{"type": "command", "command": "\"$CLAUDE_PROJECT_DIR/.graphy/hooks/session_end.sh\"", "timeout": 30}]}
    ],
    "SessionStart": [
      {"matcher": "startup|clear|compact",
       "hooks": [{"type": "command", "command": "\"$CLAUDE_PROJECT_DIR/.graphy/hooks/session_start.sh\"", "timeout": 15}]}
    ],
    "PreToolUse": [
      {"matcher": "Edit|Write|MultiEdit",
       "hooks": [{"type": "command", "command": "\"$CLAUDE_PROJECT_DIR/.graphy/hooks/before_edit.sh\"", "timeout": 20}]}
    ]
  }
}
