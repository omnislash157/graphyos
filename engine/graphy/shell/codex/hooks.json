{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"{{repo}}/.graphy/hooks/session_start.sh\"",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"{{repo}}/.graphy/hooks/session_end.sh\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"{{repo}}/.graphy/hooks/session_end.sh\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
